@model IList<JapnesseCafe.Models.CartItem>
@{
    ViewBag.Title = "Cart";
    var grandTotal = Model.Sum(x => x.Total);
}

<section class="page-header">
    <div class="container">
        <span class="kicker">Cart</span>
        <h1>Your cafe and anime haul</h1>
        <p>Menu items and merchandise share one simple Session cart.</p>
    </div>
</section>

<div class="container py-5">
    @if (!Model.Any())
    {
        <div class="empty-state">
            Your cart is empty. Add a latte, a bento, or a figure to begin.
            <div class="mt-3">
                @Html.ActionLink("View Menu", "Index", "Menu", null, new { @class = "btn btn-cafe me-2" })
                @Html.ActionLink("View Shop", "Index", "Products", null, new { @class = "btn btn-outline-cafe" })
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive admin-panel">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Type</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td><span class="badge category-badge">@item.ItemType</span></td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@item.Total.ToString("C")</td>
                            <td class="text-end">
                                @using (Html.BeginForm("Remove", "Cart", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("key", item.CartKey)
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Grand Total</th>
                        <th>@grandTotal.ToString("C")</th>
                        <th></th>
                    </tr>
                </tfoot>
            </table>
        </div>
        using (Html.BeginForm("Checkout", "Cart", FormMethod.Post, new { @class = "text-end mt-4" }))
        {
            @Html.AntiForgeryToken()
            <button class="btn btn-cafe btn-lg" type="submit">Fake checkout</button>
        }
    }
</div>

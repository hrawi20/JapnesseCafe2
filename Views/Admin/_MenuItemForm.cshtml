@model JapnesseCafe.Models.MenuItem
@{
    var action = ViewData["Action"] as string;
}

@using (Html.BeginForm(action, "Admin", FormMethod.Post, new { enctype = "multipart/form-data", @class = "admin-panel" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.Id)
    @Html.HiddenFor(m => m.CreatedAt)
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    <div class="row g-3">
        <div class="col-md-6">
            @Html.LabelFor(m => m.Name, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.Category, new { @class = "form-label" })
            @Html.DropDownListFor(m => m.Category, new SelectList(new[] { "Drinks", "Desserts", "Snacks", "Main Course Meals" }, Model.Category), "Choose category", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Category, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-3">
            @Html.LabelFor(m => m.Price, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Price, new { @class = "form-control", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(m => m.Price, "", new { @class = "text-danger" })
        </div>
        <div class="col-12">
            @Html.LabelFor(m => m.Description, new { @class = "form-label" })
            @Html.TextAreaFor(m => m.Description, 4, 40, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
        </div>
        <div class="col-md-8">
            <label class="form-label" for="imageFile">Upload image</label>
            <input class="form-control" type="file" id="imageFile" name="imageFile" accept="image/*" />
            <div class="form-text">Images are saved directly in SQL Server.</div>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                @Html.CheckBoxFor(m => m.IsAvailable, new { @class = "form-check-input" })
                @Html.LabelFor(m => m.IsAvailable, new { @class = "form-check-label" })
            </div>
        </div>
    </div>
    <div class="mt-4">
        <button class="btn btn-cafe" type="submit">Save</button>
        @Html.ActionLink("Cancel", "MenuItems", null, new { @class = "btn btn-outline-secondary ms-2" })
    </div>
}

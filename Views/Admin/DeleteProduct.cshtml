@model JapnesseCafe.Models.Product
@{
    ViewBag.Title = "Delete Product";
}

<div class="container py-5">
    <div class="admin-panel">
        <h1>Delete @Model.Name?</h1>
        <p>This will remove the product and its database-stored image.</p>
        @using (Html.BeginForm("DeleteProduct", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Id)
            <button class="btn btn-danger" type="submit">Delete</button>
            @Html.ActionLink("Cancel", "Products", null, new { @class = "btn btn-outline-secondary ms-2" })
        }
    </div>
</div>
